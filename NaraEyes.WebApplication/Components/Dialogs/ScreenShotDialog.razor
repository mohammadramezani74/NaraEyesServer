@using MudBlazor

@code {
    [Parameter] public string ImageDataUrl { get; set; } = default!;
    [Parameter] public string? Title { get; set; }
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
}

<MudDialog Class="rounded-xl">

    <DialogContent>
        <div style="display:flex; justify-content:center; align-items:center; max-height:70vh; overflow:auto;">
            <img src="@ImageDataUrl" alt="screenshot" style="max-width:100%; max-height:70vh; height:auto; display:block;" />
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="()=>MudDialog.Close()">بستن</MudButton>
    </DialogActions>
</MudDialog>
