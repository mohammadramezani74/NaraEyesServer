<MudDialog>
    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-2">
            حذف دستگاه با IP @DeviceIp
        </MudText>

        <MudText Typo="Typo.body2" Class="mb-2">
            لطفاً دلیل حذف / آرشیو دستگاه را وارد کنید.
        </MudText>

        <MudForm @ref="_form">
            <MudTextField @bind-Value="Reason"
                          Label="دلیل حذف / آرشیو"
                          Required="true"
                          RequiredError="وارد کردن دلیل الزامی است."
                          Lines="3"
                          Text="@Reason"
                          FullWidth="true"
                          AutoFocus="true" />
        </MudForm>

    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            انصراف
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Save">
            حذف
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;


    [Parameter] public string DeviceIp { get; set; } = string.Empty;

    private MudForm? _form;
    private string Reason { get; set; } = string.Empty;

    private async Task Save()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid)
                return;
        }

        // نتیجه‌ی دیالوگ = متن دلیل حذف
        MudDialog.Close(DialogResult.Ok(Reason));
    }

    private void Cancel() => MudDialog.Cancel();
}