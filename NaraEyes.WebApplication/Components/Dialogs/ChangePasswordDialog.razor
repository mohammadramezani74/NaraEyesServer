@using MudBlazor
@using NaraEyes.Application.Contracts.Models.Identity

<MudDialog Class="nx-dialog">
    <DialogContent >
        <!-- Header -->
        <div class="nx-header">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" />
            <div class="nx-title">
                <MudText Typo="Typo.h6" Class="font-bold">تغییر رمز عبور</MudText>
                <MudText Typo="Typo.caption" Class="opacity-80">لطفاً اطلاعات زیر را تکمیل کنید</MudText>
            </div>
        </div>

        <!-- Form -->
        <div class="nx-body">
            <MudForm @ref="_form">
                <MudGrid GutterSize="GutterSize.Small">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.CurrentPaaword"
                                      Label="رمز عبور فعلی"
                                      InputType="@(_showCurrent? InputType.Text: InputType.Password)"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showCurrent? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showCurrent = !_showCurrent)"
                                      Immediate="true"
                                      Class="w-full" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.NewPassword"
                                      Label="رمز عبور جدید"
                                      InputType="@(_showNew? InputType.Text: InputType.Password)"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showNew? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showNew = !_showNew)"
                                      Immediate="true"
                                      Class="w-full"
                                      OnInput="@( (ChangeEventArgs e) => _pwdStrength = CalcStrength(e?.Value?.ToString()) )" />

                 
                      
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.ConfirmPassword"
                                      Label="تأیید رمز عبور جدید"
                                      InputType="@(_showConfirm? InputType.Text: InputType.Password)"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirm? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                                      Immediate="true"
                                      Class="w-full" />
                    </MudItem>
                </MudGrid>

                <!-- پیام خطا/راهنما -->
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
                }
                <MudText Typo="Typo.caption" Class="opacity-80 mt-2">
                    پیشنهاد: حداقل ۸ کاراکتر شامل حروف بزرگ/کوچک، عدد و نماد.
                </MudText>
            </MudForm>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" StartIcon="@Icons.Material.Filled.Close">
            انصراف
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TrySave" Disabled="@_saving" Loading="@_saving" StartIcon="@Icons.Material.Filled.CheckCircle">
            ثبت
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    // مدل شما:
    // public sealed record ChangePasswordModel(string CurrentPaaword, string NewPassword, string ConfirmPassword);
    [Parameter] public ChangePasswordModel Model { get; set; } = new("", "", "");

    private ChangePasswordModel _model = new("", "", "");
    private MudForm? _form;
    private bool _saving;
    private string _error = string.Empty;

    // چشم‌ها
    private bool _showCurrent, _showNew, _showConfirm;

    // قدرت رمز (۰ تا ۱۰۰)
    private double _pwdStrength;

    protected override void OnInitialized()
    {
        // اگر ورودی داری، کپی کن تا بایند دوطرفه به رکورد آسیب نزنه
        _model = new ChangePasswordModel(Model.CurrentPaaword, Model.NewPassword, Model.ConfirmPassword);
    }

    private async Task TrySave()
    {
        _error = string.Empty;
        if (_form is null) return;

        await _form.Validate();

        // چک‌های دستی (سریع و ساده)
        if (string.IsNullOrWhiteSpace(_model.CurrentPaaword) ||
            string.IsNullOrWhiteSpace(_model.NewPassword) ||
            string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        { _error = "همهٔ فیلدها الزامی هستند."; return; }

        // if (!string.Equals(_model.NewPassword.Trim(), _model.ConfirmPassword.Trim(), StringComparison.Ordinal))
        // { _error = "رمز جدید با تأیید آن مطابقت ندارد."; return; }

        if (string.Equals(_model.NewPassword, _model.CurrentPaaword, StringComparison.Ordinal))
        { _error = "رمز جدید نباید با رمز فعلی یکسان باشد."; return; }

        _saving = true;
        try
        {
            MudDialog.Close(DialogResult.Ok(_model));
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private static double CalcStrength(string? pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        int score = 0;
        if (pwd.Length >= 8) score += 25;
        if (pwd.Any(char.IsLower) && pwd.Any(char.IsUpper)) score += 25;
        if (pwd.Any(char.IsDigit)) score += 25;
        if (pwd.Any(ch => !char.IsLetterOrDigit(ch))) score += 25;
        return Math.Min(score, 100);
    }
}
