@page "/license-status"
@using NaraEyes.Application.Contracts.Utilities
@using NaraEyes.Application.Abstraction.License
@inject ILicenseValidationService LicenseService

<div class="container mt-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-primary text-white text-center py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="fas fa-key fa-3x mb-2"></i>
                    <h3 class="mb-0 fw-bold">وضعیت لایسنس</h3>
                    <p class="mb-0 opacity-75">اعتبار نرم‌افزار شما</p>
                </div>

                <div class="card-body p-4">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">در حال بارگذاری...</span>
                            </div>
                            <p class="mt-3 text-muted">در حال بررسی لایسنس...</p>
                        </div>
                    }
                    else if (isExpired)
                    {
                        <div class="text-center">
                            <div class="mb-4">
                                <i class="fas fa-times-circle text-danger fa-5x"></i>
                            </div>
                            <h4 class="text-danger fw-bold">لایسنس منقضی شده است</h4>
                            <p class="text-muted mt-3">
                                تاریخ اعتبار لایسنس شما به پایان رسیده.<br />
                                برای ادامه استفاده، لطفاً لایسنس جدید تهیه کنید.
                            </p>
                            <div class="alert alert-light mt-4 border-start border-danger border-4 text-end">
                                <i class="fas fa-calendar-alt text-danger me-2"></i>
                                <strong>تاریخ انقضا:</strong> @expirationDate.ToFarsiFull()
                            </div>
                        </div>
                    }
                    else
                    {
                        var daysLeft = (int)(expirationDate - DateTime.UtcNow).TotalDays;
                        <div class="text-center">
                            <div class="mb-4">
                                <i class="fas fa-check-circle text-success fa-5x"></i>
                            </div>
                            <h4 class="text-success fw-bold">لایسنس فعال است</h4>
                            <p class="text-muted mt-3">
                                نرم‌افزار شما تا تاریخ زیر اعتبار دارد.
                            </p>
                            <div class="display-6 fw-bold text-primary my-3">
                                @expirationDate.ToFarsiFull()
                            </div>
                            <div class="progress mb-3" style="height: 10px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @(Math.Min(100, Math.Max(0, (daysLeft / 365f) * 100)))%"
                                     aria-valuenow="@daysLeft" aria-valuemin="0" aria-valuemax="365">
                                </div>
                            </div>
                            <p class="small text-muted">
                                <i class="far fa-clock me-1"></i>
                                @if (daysLeft > 0)
                                {
                                    <span>@daysLeft روز تا پایان اعتبار باقی مانده است</span>
                                }
                                else if (daysLeft == 0)
                                {
                                    <span>امروز آخرین روز اعتبار است</span>
                                }
                            </p>
                        </div>
                    }
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <small class="text-muted">
                        <i class="fas fa-info-circle"></i>
                        در صورت نیاز به تمدید، با پشتیبانی تماس بگیرید.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isExpired = false;
    private DateTime expirationDate;

    protected override async Task OnInitializedAsync()
    {
        var licenseInfo = await LicenseService.GetLicenseInfoAsync();
        if (licenseInfo == null)
        {
            isExpired = true;
            expirationDate = DateTime.UtcNow; // مقدار پیش‌فرض
        }
        else
        {
            expirationDate = licenseInfo.ExpirationDate;
            isExpired = expirationDate < DateTime.UtcNow;
        }
        isLoading = false;
    }
}