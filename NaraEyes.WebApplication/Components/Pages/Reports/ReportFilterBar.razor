@using System.Globalization
@using MudBlazor
@using NaraEyes.Application.Contracts.Models.Basic
@using NaraEyes.Application.Contracts.Models.Reports
@using NaraEyes.Domain.Enumerations

@*
    نوار فیلتر مشترک همه‌ی گزارش‌ها.

    DateRange مخصوص مادبلیزر است و فقط اینجا استفاده می‌شود؛ مقدارش به
    From/To ساده در ReportFilterBase نگاشت می‌شود تا لایه‌ی Application
    به کتابخانه‌ی رابط کاربری وابسته نشود.
*@

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid Spacing="2" AlignItems="Center">

        @if (ShowDateRange)
        {
            <MudItem xs="12" md="3">
                <MudDateRangePicker DateRange="_range"
                                    DateRangeChanged="OnRangeChanged"
                                    Label="بازه زمانی"
                                    Culture="@PersianCulture"
                                    Dense="true"
                                    Variant="Variant.Outlined"
                                    Clearable="false"
                                    PickerVariant="PickerVariant.Dialog" />
            </MudItem>
        }

        @if (ShowSupervision)
        {
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="Guid ?"
                           Value="Filter.SupervisionId"
                           ValueChanged="OnSupervisionChanged"
                           Label="سرپرستی"
                           Dense="true"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="Guid ?" Value="@((Guid?)null)">همه سرپرستی‌ها</MudSelectItem>
                    @foreach (var s in Supervisions)
                    {
                        <MudSelectItem T="Guid ?" Value="@((Guid?)s.Id)">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        @if (ShowBranch)
        {
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="Guid ?"
                           @bind-Value="Filter.BranchId"
                           Label="شعبه"
                           Dense="true"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="Guid ?" Value="@((Guid?)null)">همه شعب</MudSelectItem>
                    @foreach (var b in FilteredBranches)
                    {
                        <MudSelectItem T="Guid ?" Value="@((Guid?)b.Id)">@b.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        @if (ShowVendor)
        {
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="DeviceVendor ?"
                           @bind-Value="Filter.Vendor"
                           Label="سازنده"
                           Dense="true"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)null)">همه سازندگان</MudSelectItem>
                    <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.Hyosung)">هیوسانگ</MudSelectItem>
                    <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.GRG)">GRG</MudSelectItem>
                    <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.Other)">سایر</MudSelectItem>
                </MudSelect>
            </MudItem>
        }

        @if (ShowSearch)
        {
            <MudItem xs="12" sm="6" md="2">
                <MudTextField @bind-Value="Filter.Search"
                              Label="جستجو"
                              Placeholder="آی‌پی / نام / سریال"
                              Dense="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        }

        @* فیلترهای اختصاصی هر گزارش *@
        @ExtraFilters

        <MudItem xs="12" md="1" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterAlt"
                       OnClick="ApplyAsync"
                       Disabled="IsLoading"
                       FullWidth="true">
                اعمال
            </MudButton>
        </MudItem>

    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ReportFilterBase Filter { get; set; } = default!;

    [Parameter]
    public EventCallback OnApply { get; set; }

    /// <summary>فیلترهای اختصاصی هر گزارش — داخل MudItem قرار دهید</summary>
    [Parameter]
    public RenderFragment? ExtraFilters { get; set; }

    [Parameter] public bool ShowDateRange { get; set; } = true;
    [Parameter] public bool ShowBranch { get; set; } = true;
    [Parameter] public bool ShowSupervision { get; set; } = true;
    [Parameter] public bool ShowVendor { get; set; } = true;
    [Parameter] public bool ShowSearch { get; set; } = true;

    [Parameter] public bool IsLoading { get; set; }

    [Parameter]
    public IReadOnlyList<BranchesViewModel> Branches { get; set; } = Array.Empty<BranchesViewModel>();

    [Parameter]
    public IReadOnlyList<SupervisionStateViewModel> Supervisions { get; set; } = Array.Empty<SupervisionStateViewModel>();

    /// <summary>نگهدارنده‌ی محلی بازه — فقط برای انتخابگر مادبلیزر</summary>
    private DateRange _range = new(DateTime.Now.Date.AddMonths(-1), DateTime.Now.Date);

    private static readonly CultureInfo PersianCulture = CreatePersianCulture();

    private static CultureInfo CreatePersianCulture()
    {
        var c = new CultureInfo("fa-IR");
        try { c.DateTimeFormat.Calendar = new PersianCalendar(); } catch { }
        return c;
    }

    protected override void OnParametersSet()
    {
        // همگام‌سازی بازه‌ی محلی با مقادیر فیلتر
        _range = new DateRange(Filter.From, Filter.To);
    }

    private void OnRangeChanged(DateRange range)
    {
        _range = range;
        Filter.From = range.Start;
        Filter.To = range.End;
    }

    /// <summary>اگر سرپرستی انتخاب شده، فقط شعب همان سرپرستی نمایش داده شوند</summary>
    private IEnumerable<BranchesViewModel> FilteredBranches =>
        Filter.SupervisionId is null
            ? Branches
            : Branches.Where(b => b.SupervisionId == Filter.SupervisionId);

    private void OnSupervisionChanged(Guid? id)
    {
        Filter.SupervisionId = id;

        // اگر شعبه‌ی انتخاب‌شده به این سرپرستی تعلق ندارد، پاکش کن
        if (Filter.BranchId is not null &&
            !FilteredBranches.Any(b => b.Id == Filter.BranchId))
        {
            Filter.BranchId = null;
        }
    }

    private async Task ApplyAsync()
    {
        Filter.Page = 1;   // با هر فیلتر جدید، به صفحه‌ی اول برگرد
        if (OnApply.HasDelegate) await OnApply.InvokeAsync();
    }
}
