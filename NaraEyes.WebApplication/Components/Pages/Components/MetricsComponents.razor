@using NaraEyes.Application.Contracts.Interfaces.Devices
@using NaraEyes.Application.Contracts.Models.Metrics
@inject NavigationManager Nav
@inject IDeviceService _service
<div class="d-flex justify-space-between align-center mb-4">
    <div class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Large" Class="me-2" />
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">جزئیات دستگاه</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">IP: @DeviceIp</MudText>
        </div>
    </div>
    <div class="d-flex" style="gap:.5rem">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/devices"))">بازگشت</MudButton>
    </div>
</div>

<!-- Top slider: کارت‌های خلاصه -->
<MudCarousel TData="object"
             Class="mud-width-full pa-0"
             Style="height:210px;"
             AutoCycle="true"
             AutoCycleTime="@(TimeSpan.FromSeconds(6))"
             ShowArrows="true"
             ShowBullets="true">

    <ChildContent>
        <MudCarouselItem>
            <!-- 👇 رنگ متن را صراحتاً روی رنگ متن استاندارد تم می‌گذاریم -->
            <div class="pa-4" style="height:100%; color: var(--mud-palette-text-primary);">
                <div class="mini-wrap">
            
                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">نام دستگاه</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.DeviceModel</MudText>
                    </MudPaper>

                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">شعبه</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.Branch</MudText>
                    </MudPaper>

                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Numbers" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">تاریخ نصب دستگاه</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.InstallationDate</MudText>
                    </MudPaper>

                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.NetworkPing" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">ورژن ایجنت</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.AgentVersion</MudText>
                    </MudPaper>
                </div>
            </div>
        </MudCarouselItem>

        <MudCarouselItem>
            <div class="pa-4" style="height:100%; color: var(--mud-palette-text-primary);">
                <div class="mini-wrap">
                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">اپراتور</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.OperatorName (@_device.OperatorMobile)</MudText>
                    </MudPaper>

                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">کد دستگاه</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.code</MudText>
                    </MudPaper>

                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">سریال دستگاه</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.DeviceSerial</MudText>
                    </MudPaper>

                    <MudPaper Class="mini" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Medium" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption">آدرس دستگاه</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@_device.Address</MudText>
                    </MudPaper>
                </div>
            </div>
        </MudCarouselItem>
    </ChildContent>
</MudCarousel>




<!-- مشخصات + گیج + نمودار مصرف -->
<MudGrid Class="mb-4">
    <MudItem xs="12" md="4">
        <MudCard Class="rounded-2xl h-100">
            <MudCardHeader>
                <MudText Typo="Typo.subtitle1" Class="fw-bold">مشخصات دستگاه</MudText>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex flex-column" style="gap:.75rem">

                    <div class="px-3 py-2 rounded-lg mud-elevation-1">
                        <div class="d-flex align-center justify-space-between">
                            <div class="d-flex align-center" style="gap:.5rem">
                                <MudIcon Icon="@Icons.Material.Filled.NetworkWifi" Size="Size.Small" />
                                <MudText Typo="Typo.body2">IP</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="fw-semibold">@DeviceIp</MudText>
                        </div>
                    </div>

                    <div class="px-3 py-2 rounded-lg mud-elevation-1">
                        <div class="d-flex align-center justify-space-between">
                            <div class="d-flex align-center" style="gap:.5rem">
                                <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" />
                                <MudText Typo="Typo.body2">RAM</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="fw-semibold">@_device.TotalRam GB</MudText>
                        </div>
                    </div>

                    <div class="px-3 py-2 rounded-lg mud-elevation-1">
                        <div class="d-flex align-center justify-space-between">
                            <div class="d-flex align-center" style="gap:.5rem">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" />
                                <MudText Typo="Typo.body2">مدل CPU</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="fw-semibold">@_device.CpuModel</MudText>
                        </div>
                    </div>

                    <div class="px-3 py-2 rounded-lg mud-elevation-1">
                        <div class="d-flex align-center justify-space-between">
                            <div class="d-flex align-center" style="gap:.5rem">
                                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Small" />
                                <MudText Typo="Typo.body2">ویندوز</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="fw-semibold">@_device.WinModel</MudText>
                        </div>
                    </div>
                    <div class="px-3 py-2 rounded-lg mud-elevation-1">
                        <div class="d-flex align-center justify-space-between">
                            <div class="d-flex align-center" style="gap:.5rem">
                                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                                <MudText Typo="Typo.body2">تایم</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="fw-semibold">@_device.Drift</MudText>
                        </div>
                    </div>

                </div>
            </MudCardContent>
         
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudCard Class="rounded-2xl h-100">
            <MudCardHeader>
                <MudText Typo="Typo.subtitle1" Class="fw-bold">مصرف فعلی</MudText>
            </MudCardHeader>

            <MudCardContent>

                <!-- سه گیج دایره‌ای: CPU / RAM / Disk -->
                <div class="gauge-wrap mb-3">

                    <MudPaper Class="gauge-card">
                        <div class="gauge-ring">
                            <MudProgressCircular Size="Size.Large" Value="@_cpuUsed" Max="100" Thickness="4" />
                            <span class="gauge-value">@($"{_cpuUsed}%")</span>
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold k-label">CPU</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Used / Free</MudText>
                            <MudProgressLinear Value="@_cpuUsed" Max="100" Class="mt-1" Rounded="true" />
                        </div>
                    </MudPaper>

                    <MudPaper Class="gauge-card">
                        <div class="gauge-ring">
                            <MudProgressCircular Color="Color.Success" Size="Size.Large" Value="@_ramUsed" Max="100" Thickness="4" />
                            <span class="gauge-value">@($"{_ramUsed}%")</span>
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold k-label">RAM</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Used / Free</MudText>
                            <MudProgressLinear Color="Color.Success" Value="@_ramUsed" Max="100" Class="mt-1" Rounded="true" />
                        </div>
                    </MudPaper>

                    <MudPaper Class="gauge-card">
                        <div class="gauge-ring">
                            <MudProgressCircular Color="Color.Success" Size="Size.Large" Value="@_diskUsed" Max="100" Thickness="4" />
                            <span class="gauge-value">@($"{_diskUsed}%")</span>
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold k-label">Disk</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Used / Free</MudText>
                            <MudProgressLinear Color="Color.Success" Value="@_diskUsed" Max="100" Class="mt-1" Rounded="true" />
                        </div>
                    </MudPaper>

                </div>

                <!-- StackedBar مینیمال: Used/Free برای CPU/RAM/Disk -->
                <MudChart ChartType="ChartType.StackedBar"
                          ChartSeries="@_stackedSeries"
                          XAxisLabels="@_metricLabels"
                          AxisChartOptions="@_axisOptions"
                          ChartOptions="@_chartOptions"
                          LegendPosition="Position.Bottom"
                          Width="100%"
                          Height="320px" />
            </MudCardContent>


        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public string? DeviceIp { get; set; }
    [Parameter]
    public DeviceMetricsViewModel _device { get; set; }

    private readonly string[] _metricLabels = new[] { "CPU", "RAM", "Disk" };
    private List<ChartSeries> _stackedSeries = new();
    private double _cpuUsed, _ramUsed, _diskUsed;
    private AxisChartOptions _axisOptions = new()
    {
        MatchBoundsToSize = true,
        StackedBarWidthRatio = 0.6,
        XAxisLabelRotation = 0
    };

    protected async override Task OnInitializedAsync()
    {
   
    }
    protected override void OnParametersSet()
    {
        if (_device.CpuUsage?.usage != null)
        {


            _cpuUsed = _device.CpuUsage.usage;
            _ramUsed = _device.RamUsage.usage;
            _diskUsed = _device.DiskUsage.usage;
            var used = new double[] { _device.CpuUsage.usage, _device.RamUsage.usage, _device.DiskUsage.usage };
            var free = new double[] { _device.CpuUsage.free, _device.RamUsage.free, _device.DiskUsage.free };

            _stackedSeries = new()
                {
                    new ChartSeries { Name = "Used %", Data = used
        },
                    new ChartSeries { Name = "Free %", Data = free }
                };
                StateHasChanged();
        }
    }
    private ChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#34d399", "#9E9E9E" } // Used / Free
    };




}
