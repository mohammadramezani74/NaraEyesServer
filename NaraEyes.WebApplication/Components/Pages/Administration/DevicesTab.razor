@using CurrieTechnologies.Razor.SweetAlert2
@using MudBlazor
@using System.Net.Http.Json
@using NaraEyes.Application.Contracts.Interfaces.Devices
@using NaraEyes.Application.Contracts.Models.Basic
@using NaraEyes.Application.Contracts.Interfaces.Base
@using NaraEyes.Application.Contracts.Models.Devices
@using NaraEyes.WebApplication.Components.Dialogs
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject IDeviceService DeviceService
@inject IJSRuntime JS
@inject SweetAlertService Swal;

<MudPaper Class="p-3 rounded-2xl mt-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="mb-2">
        <MudTextField T="string"
                      @bind-Value="_search"
                      Placeholder="جستجو دستگاه (کُد/IP/سریال/مدل)..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="w-96"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebouncedValueChanged="(_ => StateHasChanged())" />
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">رفرش</MudButton>
            <!-- اگر ایجاد دستگاه داری، این دکمه را فعال کن -->
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDevice">افزودن</MudButton>
            <MudIconButton OnClick="AddDeviceWithExcel" Color="Color.Success"
                           Variant="Variant.Filled"
                           Size="Size.Medium"
                           Class="ml-2" Icon="@Icons.Custom.FileFormats.FileExcel">خروجی اکسل</MudIconButton>
        </MudStack>
    </MudStack>

    <MudTable Items="_devices"
              Dense="true" Hover="true" Bordered="true"
              Filter="DeviceFilter" Loading="_loading">
        <ColGroup>
            <col style="width: 110px;" />
            <col style="width: 160px;" />
            <col style="width: 220px;" />
            <col />
            <col style="width: 110px;" />
        </ColGroup>

        <HeaderContent>
            <MudTh>کُد</MudTh>
            <MudTh>IP</MudTh>
            <MudTh>شماره سریال</MudTh>
            <MudTh>مدل</MudTh>
            <MudTh class="text-end">عملیات</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="کُد">@context.Code</MudTd>
            <MudTd DataLabel="IP">@context.Ip</MudTd>
            <MudTd DataLabel="سریال">@context.SerialNo</MudTd>
            <MudTd DataLabel="مدل">@context.Model</MudTd>
            <MudTd Class="text-end">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => EditDevice(context))" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => DeleteDevice(context))" />
                
                </MudStack>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-3" />
            }
            else
            {
                <MudText Class="text-secondary">رکوردی یافت نشد.</MudText>
            }
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private string _search = "";
    private bool _loading = true;
    private List<GetDevicesViewModel> _devices = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            _loading = true;
            StateHasChanged();
            _devices = (await DeviceService.GetDevicesAsync(CancellationToken.None)).ToList();
        }
        catch
        {
            Snackbar.Add("خطا در دریافت لیست دستگاه‌ها.", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private bool DeviceFilter(GetDevicesViewModel d)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var s = _search.Trim();
        return (d.Code?.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Ip?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.SerialNo?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Model?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task EditDevice(GetDevicesViewModel vm)
    {
        var upd = new UpdateDeviceViewModel
        {
            Id = vm.Id,
            Code = vm.Code,
            Ip = vm.Ip,
            Description = vm.Description,
            Vendor=vm.Vendor,
            InstallationDate = vm.InstallationDate,   // nullable در مدل Update؛ مقدار فعلی را پاس می‌دهیم
            Address = vm.Address,
            AgentVersion = vm.AgentVersion,           // فقط نمایش؛ DeviceDialog آن را ReadOnly نشان می‌دهد
            BranchId = vm.BranchId,
            IsActive = vm.IsActive,
            Latitude = vm.Latitude,
            Longitude = vm.Longitude,
            MobileNo = vm.MobileNo,
            Model = vm.Model,
            SerialNo = vm.SerialNo,
            Tel = vm.Tel,
            newContact = new newcontact(vm.OperatorName, vm.OperatorTel, vm.OperatorphoneNumber, vm.OperatorAddress,vm.OperatorEmail)
        };

        var parameters = new DialogParameters<DeviceDialog> { { x => x.Model, upd } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = Dialog.Show<DeviceDialog>($"ویرایش دستگاه «{vm.Ip}»", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool ok && ok)
        {
            Snackbar.Add("تغییرات ذخیره شد.", Severity.Success);
            await Load();
        }
    }

    private async Task DeleteDevice(GetDevicesViewModel vm)
    {
        var parameters = new DialogParameters
        {
            ["DeviceIp"] = vm.Ip
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
        };


        var dialog = Dialog.Show<DeleteDeviceDialog>("حذف دستگاه", parameters, options);
        var result = await dialog.Result;


        if (result.Canceled)
            return;


        var reason = result.Data as string ?? string.Empty;

     
            try
            {
            await DeviceService.DeactivateAsync(vm.Id, reason, CancellationToken.None);
                Snackbar.Add("غیرفعال شد.", Severity.Success);
                await Load();
            }
            catch
            {
                Snackbar.Add("حذف/غیرفعال‌سازی با خطا مواجه شد.", Severity.Error);
            }
        
    }
    private async Task AddDevice(MouseEventArgs args)
    {


        var parameters = new DialogParameters<AddDeviceDialoge> ();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = Dialog.Show<AddDeviceDialoge>($"افزودن دستگاه", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool ok && ok)
        {
            Snackbar.Add("تغییرات ذخیره شد.", Severity.Success);
            await Load();
        }
    }
    private async Task AddDeviceWithExcel(MouseEventArgs args)
    {
        var options = new DialogOptions()
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {

        };

        var dialog = Dialog.Show<DevicesExcelDialog>(
            "عملیات اکسل روی دستگاه‌ ها",
            parameters,
            options);

        var result = await dialog.Result;
        if (result.Canceled)
            return;

        if (result.Data is int action)
        {

            if (action == 1)
            {
                var base64 = await DeviceService.GetDeviceReport();
                if (string.IsNullOrWhiteSpace(base64))
                {
                    await Swal.FireAsync("خطا", "فایل تولید نشد.", SweetAlertIcon.Error);
                    return;
                }

                var mime = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                var fileName = $"گزارش-دستگاه ها-{DateTime.Now:yyyyMMddHHmmss}.xlsx";


                await JS.InvokeVoidAsync("downloadBase64File", mime, base64, fileName);
            }
            if (action == 2)
            {
                var base64 = await DeviceService.GetSampleFileForDownload();
                if (string.IsNullOrWhiteSpace(base64))
                {
                    await Swal.FireAsync("خطا", "فایل تولید نشد.", SweetAlertIcon.Error);
                    return;
                }

                var mime = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                var fileName = $"دانلود فایل نمونه.xlsx";


                await JS.InvokeVoidAsync("downloadBase64File", mime, base64, fileName);
            }
            if (action == 3)
            {

                await Swal.FireAsync("عملیات", "ایمپورت فایل اکسل با موفقیت انجام شد", SweetAlertIcon.Success);
                _devices = (await DeviceService.GetDevicesAsync(CancellationToken.None)).ToList();
                return;


            }
            if (action == 4)
            {

                await Swal.FireAsync("خطا", "ایمپورت فایل اکسل با خطا مواجه شد", SweetAlertIcon.Error);
                return;


            }
    }
}
}