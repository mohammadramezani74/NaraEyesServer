@page "/devices/{ip}"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using NaraEyes.Application.Abstraction.Logger
@using NaraEyes.Application.Contracts.Interfaces.Devices
@using NaraEyes.Application.Contracts.Interfaces.Modules
@using NaraEyes.Application.Contracts.Models.Metrics
@using NaraEyes.Application.Contracts.Models.Modules
@using NaraEyes.Application.Contracts.Models.Modules.CDM
@using NaraEyes.Application.Contracts.Utilities
@using NaraEyes.Domain.Enumerations
@using NaraEyes.WebApplication.Components.Dialogs
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDeviceService service
@inject IModuleServices _moduleServices
@inject IDialogService Dialog
@inject IAppLogger _logger;
@attribute [Authorize(Roles = "مدیریت مانیتورینگ,مدیریت مرکزی")]

<PageTitle>Device Detail</PageTitle>

<style>

    .mini-wrap {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 12px;
        height: 100%;
    }

    .mini {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        padding: 12px;
        height: 100%;
        color: var(--mud-palette-text-primary);
    }
    @@media (max-width: 960px) {
        .mini-wrap

    {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }

    }
    @@media (max-width: 600px) {
        .mini-wrap

    {
        grid-template-columns: 1fr;
    }

    }
    .gauge-wrap {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 12px;
    }
    @@media (max-width: 900px) {
        .gauge-wrap

    {
        grid-template-columns: 1fr;
    }

    }

    .gauge-card {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .9rem;
        border-radius: 16px;
    }

    .gauge-ring {
        position: relative;
        width: 76px;
        height: 76px;
        display: grid;
        place-items: center;
    }

    .gauge-value {
        position: absolute;
        font-weight: 700;
        font-size: .95rem;
    }

    .k-label {
        line-height: 1.2;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-4">

    <MetricsComponents DeviceIp="@ip" _device="_deviceMetrics"></MetricsComponents>

    <!-- XFS Status -->
    <MudCard Class="rounded-2xl mb-4">
        <MudCardHeader>
            <div class="d-flex align-center" style="gap:.5rem">
                <MudIcon Icon="@Icons.Material.Filled.Build" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold">XFS وضعیت ماژول‌ها</MudText>
            </div>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                @foreach (var m in _xfsModules)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudPaper Class="p-3 rounded-xl d-flex flex-column" Style="gap:.5rem; height:100%">
                            <div class="d-flex align-center justify-space-between">
                                <MudText Typo="Typo.body1" Class="fw-semibold">@m.Name</MudText>
                                <MudChip T="string" Color="@GetXfsColor(m.HealthStatus)" Variant="Variant.Filled" Size="Size.Small">@m.Status</MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@m.Description</MudText>
                            <div class="mt-auto d-flex" style="gap:.5rem">
                                @if ((m.Name == ModuleCreationHelper.Dispenser ||
                                                              m.Name == ModuleCreationHelper.IDC ||
                                                              m.Name == ModuleCreationHelper.Ptr)&& !IsInService
                                  )
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RestartAlt" Disabled="@IsResetting(m)"
                                    OnClick="@(() => ResetModule(m))">ریست</MudButton>}
                                @if (IsResetting(m))
                                {
                                    <MudProgressCircular Class="ms-1" Size="Size.Small" Color="Color.Secondary" Indeterminate="true" />
                                  
                                }
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Info" OnClick="@(() => GetInfo(m.ModuleId,m.Name))">جزئیات</MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <!-- Cassettes -->
    <MudCard Class="rounded-2xl">
        <MudCardHeader>
            <div class="d-flex align-center" style="gap:.5rem">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold">اطلاعات کاست‌ها</MudText>
            </div>
        </MudCardHeader>
        <MudCardContent>
            <MudTable T="Cassette" Items="@_cassettes" Dense="true" Hover="true" Bordered="true" Class="rounded-xl overflow-hidden">
                <HeaderContent>
                    <MudTh>نام</MudTh>
                    <MudTh>نوع</MudTh>
                    <MudTh>ارزش</MudTh>
                    <MudTh>واحد</MudTh>
                    <MudTh>ظرفیت</MudTh>
                    <MudTh>مانده</MudTh>
                    <MudTh>وضعیت</MudTh>
                    <MudTh>موجودی</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="نام">@context.Name</MudTd>
                    <MudTd DataLabel="نوع">@context.Type</MudTd>
                    <MudTd DataLabel="ارزش">@context.Denomination.ToMoney()</MudTd>
                    <MudTd DataLabel="واحد">@context.Currency</MudTd>
                    <MudTd DataLabel="ظرفیت">@context.Capacity.ToString("N0")</MudTd>
                    <MudTd DataLabel="مانده">
                        <div class="d-flex align-center">
                            <MudProgressLinear Value="@context.FillPercent" Max="100" Rounded="true" Class="me-2" Style="width:160px" />
                            <MudText Typo="Typo.caption">@($"{context.Remaining:N0} ({context.FillPercent:0}%)")</MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="وضعیت">
                        @if (context.Name == "LCU00" || context.Name == "PCU00")
                        {
                            <MudChip T="string" Color="@GetCassetteColor("OK")" Variant="Variant.Filled" Size="Size.Small">Ok</MudChip>
                        }
                        else{
                        <MudChip T="string" Color="@GetCassetteColor(context.Status)" Variant="Variant.Filled" Size="Size.Small">@context.Status</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="موجودی">
           
                        <MudTd DataLabel="موجودی">@context.TotalMoney</MudTd>
                        
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>

</MudContainer>

@code {
    [Parameter] public string ip { get; set; }
    private  string Dispenser { get; set; }
    private string IDC = "کارت خوان";

    private string Ptr = "پرینتر رسید";
    private string Cam = "دوربین";
    private string Sensors = "سنسورها";
    private readonly HashSet<Guid> _resetting = new();
    private bool IsInService = false;

    // هلپر
    private bool IsResetting(XfsModule m) => _resetting.Contains(m.ModuleId);

    // ===== Fake models =====
    private class DeviceHeader
    {
        public string DisplayName { get; set; } = "";
        public string Branch { get; set; } = "";
        public string SerialNo { get; set; } = "";
        public string OperatorName { get; set; } = "";
        public DateTime LastSeen { get; set; }
        public int LastPingMs { get; set; }
        public double TotalRamGb { get; set; }
        public string CpuModel { get; set; } = "";
    }


    private DeviceHeader _device = new();
    private List<XfsModule> _xfsModules = new();
    private List<Cassette> _cassettes = new();

    public DeviceMetricsViewModel _deviceMetrics { get; set; } = new();
    private CancellationTokenSource _loadCts;

    // ===== Chart state (Used/Free) =====


    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        Dispenser = ModuleCreationHelper.Dispenser;
        IDC = ModuleCreationHelper.IDC;
        Ptr = ModuleCreationHelper.Ptr;
        Cam = ModuleCreationHelper.Cam;
        Sensors = ModuleCreationHelper.Sensors;
        _deviceMetrics = await service.GetMetricsAsync(ip);
        IsInService = await _moduleServices.IsDeviceInservice(ip,_loadCts.Token);


        _xfsModules =await  _moduleServices.GetModulesStatus(ip,_loadCts.Token).ConfigureAwait(true);
        await Task.Delay(500);
        _cassettes = await _moduleServices.GetCassetInfo(ip, _loadCts.Token);


    }



