    {
        var i = 0;
        __builder.OpenComponent<MudPaper>(i++); __builder.AddAttribute(i++, "Class", "p-3 rounded-xl h-100");
        __builder.AddAttribute(i++, "ChildContent", (RenderFragment)(__b =>
        {
            var j = 0;
            __b.OpenElement(j++, "div"); __b.AddAttribute(j++, "class", "d-flex align-center"); __b.AddAttribute(j++, "style", "gap:.75rem");
            __b.OpenComponent<MudIcon>(j++); __b.AddAttribute(j++, "Icon", icon); __b.AddAttribute(j++, "Size", Size.Medium); __b.CloseComponent();
            __b.OpenElement(j++, "div");
            __b.OpenComponent<MudText>(j++); __b.AddAttribute(j++, "Typo", Typo.caption); __b.AddContent(j++, title); __b.CloseComponent();
            __b.OpenComponent<MudText>(j++); __b.AddAttribute(j++, "Typo", Typo.body1); __b.AddAttribute(j++, "Class", "fw-bold"); __b.AddContent(j++, value); __b.CloseComponent();
            __b.CloseElement();
            __b.CloseElement();
        }));
        __builder.CloseComponent();
    };

    private RenderFragment KeyValueRow(string icon, string key, string value) => __builder =>
    {
        var i = 0;
        __builder.OpenComponent<MudPaper>(i++); __builder.AddAttribute(i++, "Class", "px-3 py-2 rounded-lg");
        __builder.AddAttribute(i++, "ChildContent", (RenderFragment)(__b =>
        {
            var j = 0;
            __b.OpenElement(j++, "div"); __b.AddAttribute(j++, "class", "d-flex align-center justify-space-between");
            __b.OpenElement(j++, "div"); __b.AddAttribute(j++, "class", "d-flex align-center"); __b.AddAttribute(j++, "style", "gap:.5rem");
            __b.OpenComponent<MudIcon>(j++); __b.AddAttribute(j++, "Icon", icon); __b.AddAttribute(j++, "Size", Size.Small); __b.CloseComponent();
            __b.OpenComponent<MudText>(j++); __b.AddAttribute(j++, "Typo", Typo.body2); __b.AddContent(j++, key); __b.CloseComponent();
            __b.CloseElement();
            __b.OpenComponent<MudText>(j++); __b.AddAttribute(j++, "Typo", Typo.body2); __b.AddAttribute(j++, "Class", "fw-semibold"); __b.AddContent(j++, value); __b.CloseComponent();
            __b.CloseElement();
        }));
        __builder.CloseComponent();
    };

    private void ReloadFakeData()
    {
        SeedFake(ip);
        Snackbar.Add("داده‌های نمونه بروزرسانی شد.", Severity.Info);
        StateHasChanged();
    }

    private void SeedFake(string deviceIp)
    {
        var rnd = new Random(deviceIp?.GetHashCode() ?? Environment.TickCount);

        _device = new DeviceHeader
        {
            DisplayName = $"ATM-{(deviceIp ?? "0.0.0.0").Replace(".", "-")}",
            Branch = "شعبه مرکزی",
            SerialNo = $"SN-{rnd.Next(100000, 999999)}",
            OperatorName = "کاربر ارشد",
            LastSeen = DateTime.Now.AddMinutes(-rnd.Next(1, 30)),
            LastPingMs = rnd.Next(20, 120),
            TotalRamGb = 3.9,
            CpuModel = "Intel(R) Core(TM) i5-4570"
        };

        // مصرف فعلی (٪)





    }

    private Color GetXfsColor(HealthStatus status) => status switch
    {
        HealthStatus.Online => Color.Primary,
        HealthStatus.PowerOff => Color.Error,
        HealthStatus.Offline => Color.Dark,
        HealthStatus.HardwareError => Color.Error,
        HealthStatus.DeviceNotFound => Color.Error,
        HealthStatus.UserError => Color.Error,
        HealthStatus.Busy => Color.Warning,
        _ => Color.Default
    };

    private Color GetCassetteColor(string status) => status switch
    {
        "OK" => Color.Primary,
        "Low" => Color.Warning,
        "Empty" => Color.Error,
        _ => Color.Default
    };

    private async Task ResetModule(XfsModule m)
    {
        if (IsResetting(m)) return;           
        _resetting.Add(m.ModuleId);
        StateHasChanged();
        try
        {
            bool ok = false;

         await   Task.Delay(3000);
            if (m.Name == Dispenser)
            {
                _logger.Info("CDM reset started. ModuleId={ModuleId}", m.ModuleId);
                ok = await service.RequestResetCdmAsync(ip);
            }
            else if (m.Name == IDC)
            {
                _logger.Info("IDC reset started. ModuleId={ModuleId}", m.ModuleId);
                ok = await service.RequestResetIdcAsync(ip);
            }
            else if (m.Name == Ptr)
            {
                _logger.Info("PTR reset started. ModuleId={ModuleId}", m.ModuleId);
                ok = await service.RequestResetPtrAsync(ip);
            }

            if (ok)
            {
                _logger.Info("Module reset SUCCESS. Module={ModuleName}, ModuleId={ModuleId}",
                    m.Name, m.ModuleId);

                Snackbar.Add($"{m.Name} ریست شد.", Severity.Success);
            }
            else
            {
                _logger.Warn("Module reset FAILED. Module={ModuleName}, ModuleId={ModuleId}",
                    m.Name, m.ModuleId);

                Snackbar.Add($"{m.Name} ریست نشد.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ریست {m.Name} با خطا مواجه شد: {ex.Message}", Severity.Error);
        }
        finally
        {
            _resetting.Remove(m.ModuleId);
            StateHasChanged();
        }
    }

    private void RecalibrateCassette(Cassette c)
    {
        c.Status = c.FillPercent < 15 ? "Empty" : (c.FillPercent < 35 ? "Low" : "OK");
        Snackbar.Add($"{c.Name} کالیبره شد.", Severity.Info);
        StateHasChanged();
    }


    private async Task GetInfo(Guid ModulId,string  Name)
    {
        if (Name == ModuleCreationHelper.Dispenser){
            var parameters = new DialogParameters
        {
            { "ModuleId", /* Guid ماژول */ ModulId }
        };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            Dialog.Show<CdmModuleDialog>("وضعیت ماژول CDM", parameters, options);}
        else if(Name == ModuleCreationHelper.IDC)
        {
            var parameters = new DialogParameters
        {
            { "ModuleId", /* Guid ماژول */ ModulId }
        };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            Dialog.Show<IdcModuleDialog>("وضعیت ماژول کارت خوان", parameters, options);
        }
        else if (Name == ModuleCreationHelper.Pin)
        {
            var parameters = new DialogParameters
        {
            { "ModuleId", /* Guid ماژول */ ModulId }
        };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            Dialog.Show<PinModuleDialog>("وضعیت ماژول پین پد", parameters, options);
        }
        else if (Name == ModuleCreationHelper.Ptr)
        {
            var parameters = new DialogParameters
        {
            { "ModuleId", /* Guid ماژول */ ModulId }
        };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            Dialog.Show<PtrModuleDialog>("وضعیت ماژول پرینتر", parameters, options);
        }
        else if (Name == ModuleCreationHelper.Cam)
        {
            var parameters = new DialogParameters
        {
            { "ModuleId", /* Guid ماژول */ ModulId }
        };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            Dialog.Show<CameraModuleDialog>("وضعیت ماژول دوربین", parameters, options);
        }
        else if (Name == ModuleCreationHelper.Sensors)
        {
            var parameters = new DialogParameters
        {
            { "ModuleId", /* Guid ماژول */ ModulId }
        };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            Dialog.Show<SiuModuleDialog>("وضعیت ماژول دوربین", parameters, options);
        }
    }

 
}
