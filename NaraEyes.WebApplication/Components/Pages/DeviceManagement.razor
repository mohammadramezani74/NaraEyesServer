@page "/devices"
@using System.Threading
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using NaraEyes.Application.Abstraction.Logger
@using NaraEyes.Application.Contracts.Interfaces.Base
@using NaraEyes.Application.Contracts.Interfaces.Devices
@using NaraEyes.Application.Contracts.Interfaces.Identity
@using NaraEyes.Application.Contracts.Models.Basic
@using NaraEyes.Application.Contracts.Models.Devices
@using NaraEyes.Domain.Enumerations            
@using NaraEyes.WebApplication.Common
@using NaraEyes.WebApplication.Components.Dialogs
@using static NaraEyes.WebApplication.Components.Dialogs.FileUploadDialog
@using NaraEyes.Domain.Enumerations
@inject ISnackbar Snackbar
@inject IDeviceService DeviceService
@inject IBranchService BranchService
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IUserService userService
@inject IAppLogger _logger;
@inject NavigationManager Nav
@implements IAsyncDisposable
@attribute [Authorize(Roles = "مدیریت استان,مدیریت مانیتورینگ,مدیریت مرکزی")]

<MudTable T="DeviceViewModel"
          ServerData="ServerReload"
          Dense="true"
          Hover="true"
          RowsPerPage="20"

          RowClassFunc="@((d,i)=>GetRowClass(d))"
          @ref="table">

    <ToolBarContent>
        <MudText Typo="Typo.h6">مدیریت دستگاه‌ها</MudText>
        <MudSpacer />

        <!-- فیلتر وضعیت -->
            <MudSelect T="DeviceMode?" Value="_status" ValueChanged="OnStatusChanged" Dense="true" Class="mx-2" Clearable="true" AnchorOrigin="Origin.BottomCenter" Placeholder="وضعیت">
            <MudSelectItem T="DeviceMode?" Value="@((DeviceMode?)null)">همه وضعیت‌ها</MudSelectItem>
            @foreach (var s in Enum.GetValues<DeviceMode>())
            {
                <MudSelectItem T="DeviceMode?" Value="@((DeviceMode?)s)">@LocalizeStatus(s,false)</MudSelectItem>
            }
        </MudSelect>

        <!-- فیلتر شعبه (از سرویس) -->
        <MudSelect T="Guid?" Value="_branchId" ValueChanged="OnBranchChanged" Dense="true" Class="mx-2" Clearable="true" AnchorOrigin="Origin.BottomCenter" Placeholder="شعبه">
            <MudSelectItem T="Guid?" Value="@(null)">همه شعب</MudSelectItem>
            @if (_branches is not null)
            {
                @foreach (var b in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@b.Id">@b.ShortName</MudSelectItem>
                }
            }
        </MudSelect>
        <MudSelect T="DeviceVendor ?" Value="_vendor" ValueChanged="OnVendorChanged" Dense="true" Class="mx-2" Clearable="true" AnchorOrigin="Origin.BottomCenter" Placeholder="سازنده">
            <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)null)">همه سازندگان</MudSelectItem>
            <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.Hyosung)">هیوسانگ</MudSelectItem>
            <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.GRG)">GRG</MudSelectItem>
            <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.Other)">سایر</MudSelectItem>
            <MudSelectItem T="DeviceVendor ?" Value="@((DeviceVendor?)DeviceVendor.Unknown)">نامشخص</MudSelectItem>
        </MudSelect>
     
        <!-- جستجو -->
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="OnSearch"
                      Placeholder="جستجو: نام/آی‌پی/سریال/شعبه"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0 w-64" />
        <MudSpacer></MudSpacer>
        <MudTooltip Text="خروجی اکسل">
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudIconButton OnClick="ExportDeviceExcel" Icon="@Icons.Custom.FileFormats.FileExcel"
                                   Color="Color.Success"
                                   Variant="Variant.Filled"
                                   Size="Size.Medium"
                                   Class="ml-2" />
                </ActivatorContent>
               
            </MudMenu>
        </MudTooltip>
    </ToolBarContent>

    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="status"   T="DeviceViewModel">وضعیت دستگاه</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="status" T="DeviceViewModel">وضعیت ایجنت</MudTableSortLabel></MudTh>
         <MudTh><MudTableSortLabel SortLabel="name"     T="DeviceViewModel">کد دستگاه</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="name"     T="DeviceViewModel">نام دستگاه</MudTableSortLabel></MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="vendor" T="DeviceViewModel">سازنده</MudTableSortLabel>
        </MudTh>
        <MudTh><MudTableSortLabel SortLabel="ip"       T="DeviceViewModel">آی‌پی</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="branch"   T="DeviceViewModel">شعبه</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="serial"   T="DeviceViewModel">سریال</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="cash"     T="DeviceViewModel">موجودی</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="updated"  T="DeviceViewModel">بروزرسانی</MudTableSortLabel></MudTh>
        <MudTh>اکشن‌ها</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="وضعیت">
            <MudChip T="string" Variant="Variant.Filled" Color="@GetStatusColor(context.Status,context.IsInservice)">
                @LocalizeStatus(context.Status,context.IsInservice)
            </MudChip>
        </MudTd>
        <MudTd DataLabel=" وضعیت ایجنت">
            <MudText Typo="Typo.body2" Class="font-semibold">
                @if (context.DeviceAgent)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="agent-dot agent-dot--on"></span>
                        <MudText Typo="Typo.body2" Class="font-semibold text-success"></MudText>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="agent-dot agent-dot--off"></span>
                        <MudText Typo="Typo.body2" Class="font-semibold text-secondary"> </MudText>
                    </div>
                }
            </MudText></MudTd>
        <MudTd DataLabel="کد دستگاه"><MudText Typo="Typo.body2" Class="font-semibold">@context.DisplayName</MudText></MudTd>
        <MudTd DataLabel="نام دستگاه"><MudText Typo="Typo.body2" Class="font-semibold">@context.Model</MudText></MudTd>
        <MudTd DataLabel="سازنده">
            @switch (context.Vendor)
            {
                case DeviceVendor.Hyosung:
                    <MudChip T="string" Size="Size.Small" Color="Color.Info"
                             Variant="Variant.Outlined">هیوسانگ</MudChip>
                    break;

                case DeviceVendor.GRG:
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                             Variant="Variant.Outlined">GRG</MudChip>
                    break;

                case DeviceVendor.Other:
                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                             Variant="Variant.Outlined">سایر</MudChip>
                    break;

                default:
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">—</MudText>
                    break;
            }
        </MudTd>
        <MudTd DataLabel="آی‌پی">@context.Ip</MudTd>
        <MudTd DataLabel="شعبه">@context.Branch</MudTd>
        <MudTd DataLabel="سریال">@(@context.SerialNo ?? "—")</MudTd>
        <MudTd DataLabel="موجودی">@context.CashInventory.ToString("N0")</MudTd>
        <MudTd DataLabel="بروزرسانی">@context.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>

        <MudTd DataLabel="اکشن‌ها">
                <MudStack Row="true">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               Title="جزئیات"
                               OnClick="@(() => Nav.NavigateTo($"/devices/{context.Ip}"))" />
            <MudMenu AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Transition="Transition.Fade">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Bolt">
                        اکشن‌ها
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem OnClick="@(() => UpdateStatuses(context))">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-2" /> بروزرسانی وضعیت‌ها
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => Screenshot(context))">
                        <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Class="mr-2" /> اسکرین‌شات
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => DownloadJournal(context))">
                        <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Class="mr-2" /> دانلود ژورنال
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => Reboot(context))">
                        <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Class="mr-2" /> ریستارت
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => Shutdown(context))">
                        <MudIcon Icon="@Icons.Material.Filled.PowerSettingsNew" Class="mr-2" /> خاموش کردن
                    </MudMenuItem>
                        <MudMenuItem OnClick="@(() => uploadDialog(context.Ip))">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-2" /> آپلود فایل
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
                </MudStack>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText>موردی پیدا نشد</MudText>
    </NoRecordsContent>

    <LoadingContent>
        <MudText>در حال بارگذاری...</MudText>
    </LoadingContent>

    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
@if (_isLoadingScreenshot)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999">
        <div class="d-flex flex-column align-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Class="mt-4" Typo="Typo.body1">در حال ارتباط با دستگاه…</MudText>
            <MudText Class="mt-1" Typo="Typo.caption">
                این عملیات ممکن است تا یک دقیقه طول بکشد.
            </MudText>
            <MudButton Class="mt-4" Variant="Variant.Text" Color="Color.Secondary"
                       OnClick="CancelLoading">
                انصراف
            </MudButton>
        </div>
    </MudOverlay>
}
<script>
    window.downloadBytes = function (base64Data, contentType, fileName) {
      const byteChars = atob(base64Data);
      const buf = new Uint8Array(byteChars.length);
      for (let i = 0; i < byteChars.length; i++) buf[i] = byteChars.charCodeAt(i);
      const blob = new Blob([buf], { type: contentType || "application/octet-stream" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = fileName || "download";
      document.body.appendChild(a);
      a.click();
      URL.revokeObjectURL(url);
      a.remove();
    };

    
</script>



@code {
    private MudTable<DeviceViewModel> table;
    private bool _disposed;
    // فیلترها
    private string _search = string.Empty;
    private DeviceMode? _status;
    private Guid? _branchId;
    private HubConnection? _hubConnection;
    private CancellationTokenSource? _cancellationTokenSource=new();
    public bool _isLoadingScreenshot { get; set; }
    private PeriodicTimer? _timer;
    private Task? _refreshLoop;
    private void CancelLoading()
    {
        _cancellationTokenSource?.Cancel();

        // توکن جدید برای عملیات بعدی
        _cancellationTokenSource = new CancellationTokenSource();

        _isLoadingScreenshot = false;
        StateHasChanged();
    }
    // شعب از سرویس
    private IReadOnlyList<BranchesViewModel>? _branches;
    private async Task SaveFileAsync(byte[] data, string fileName, string contentType)
    {
        await JS.InvokeVoidAsync("downloadBytes",
            Convert.ToBase64String(data), contentType, fileName);
    }
    private static bool LooksLikeZip(byte[] data)
    => data != null && data.Length >= 4 && data[0] == 0x50 && data[1] == 0x4B; // 'PK'
    private AsyncOperationRunner _ops = default!;
    protected override async Task OnInitializedAsync()
    {
        try
        {
         

            _branches = await BranchService.GetAllBranches(_cancellationTokenSource!.Token);
            _ops = new AsyncOperationRunner(
        owner: this,
        snackbar: Snackbar,
        invokeAsync: f => InvokeAsync(f),
        setBusy: b => _isLoadingScreenshot = b,
        logError: (ex, msg) => _logger.Error(ex, msg));
        }
        catch (Exception ex)
        {
            _logger.Error(ex, "Loading branches failed");
            _branches = Array.Empty<BranchesViewModel>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // تایمر بعد از اولین رندر شروع می‌شود تا table حتماً مقدار داشته باشد
        _timer = new PeriodicTimer(TimeSpan.FromMinutes(2));

        _refreshLoop = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(_cancellationTokenSource!.Token))
                {
                    if (_disposed) break;

                    // اگر کاربر در حال انجام کاری است، این دور را رد کن
                    if (_isLoadingScreenshot) continue;

                    await InvokeAsync(async () =>
                    {
                        if (_disposed || table is null) return;
                        try { await table.ReloadServerData(); }
                        catch (Exception ex) { _logger.Warn("Auto-refresh failed"); }
                    });
                }
            }
            catch (OperationCanceledException) { /* عادی */ }
            catch (Exception ex) { _logger.Error(ex, "Refresh loop crashed"); }
        });
    }
    private readonly SemaphoreSlim _reloadGate = new(1, 1);
    // ---- Server reload (paging + sorting + filtering) ----
    private async Task<TableData<DeviceViewModel>> ServerReload(TableState state, CancellationToken token)
    {
        await _reloadGate.WaitAsync(token);
        try
        {
            var filter = new DeviceFilterViewModel
            {
                Search = _search,
                Status = _status,
                Vendor = _vendor,
                Branch = _branchId,
                Page = state.Page + 1,              // TableState.Page صفر مبناست
                PageSize = state.PageSize,
                SortLabel = state.SortLabel,
                SortDirection = MapSortDirection(state.SortDirection)
            };

            var result = await DeviceService.GetAllDevicesAsync(filter, token);

            return new TableData<DeviceViewModel>
            {
                TotalItems = result.Total,
                Items = result.Items
            };
        }
        finally { _reloadGate.Release(); }

    }

    // ---- Filters handlers ----
    private void OnSearch(string text)            { _search = text ?? string.Empty; table.ReloadServerData(); }
    private void OnStatusChanged(DeviceMode? s)   { _status = s; table.ReloadServerData(); }
    private void OnBranchChanged(Guid? id)        { _branchId = id; table.ReloadServerData(); }

    // ---- Row class (tint by status) ----
    private string GetRowClass(DeviceViewModel d) => d.Status switch
    {
        DeviceMode.Error     => "row-error",
        DeviceMode.warning   => "row-warning",
        DeviceMode.InService => "row-inservice",
        DeviceMode.Offline   => "row-offline",
        _ => string.Empty
    };

    // ---- Helpers ----
    private static SortDirectionDto MapSortDirection(SortDirection dir) => dir switch
    {
        SortDirection.Ascending  => SortDirectionDto.Ascending,
        SortDirection.Descending => SortDirectionDto.Descending,
        _                        => SortDirectionDto.None
    };

    private Color GetStatusColor(DeviceMode s, bool isInservice)
    {
        switch(s)
        {
            case DeviceMode.InService:
                {
                    return Color.Success;

                };
            case DeviceMode.warning_paper:
                {
                    if(isInservice)
                        return Color.Success;
                    return Color.Warning;

                }
            case DeviceMode.warning_Money:
                {
                    if (isInservice)
                        return Color.Success;
                    return Color.Warning;

                }
            case DeviceMode.Error:
                {
                    if (isInservice)
                        return Color.Success;
                    return Color.Error;

                }
            case DeviceMode.Offline:
                {
                    return Color.Dark;

                }
            case DeviceMode.Supervisor:
                {
                    return Color.Secondary;

                }
            case DeviceMode.Online:
                {
                    return Color.Surface;

                }
            default:
                return Color.Default;
        };
        return Color.Default;
    }

    private string LocalizeStatus(DeviceMode s, bool isInservice)
    {

        switch (s)
        {
            case DeviceMode.InService:
                {
                    return "سرویس دهی";

                }
                ;
            case DeviceMode.warning_paper:
                {
                    if (isInservice)
                        return "سرویس دهی (کمبود کاغذ)";
                    return ("کمبود کاغذ");

                }
            case DeviceMode.warning_Money:
                {
                    if (isInservice)
                        return "سرویس دهی (کمبود موجودی)";
                    return ("کمبود موجودی");

                }
            case DeviceMode.Error:
                {
                    if (isInservice)
                        return "سرویس دهی (خطای ماژول)";
                    return (" خطا");

                }
            case DeviceMode.Offline:
                {
                    return "آفلاین";

                }
            case DeviceMode.Supervisor:
                {
                    return "خارج از سرویس";

                }
            case DeviceMode.Online:
                {
                    return "آنلاین";

                }
            default:
                return "نامشخص";
        }
        ;
        return "نامشخص";
    } 

    // ---- Actions (فعلاً Snackbar؛ بعداً به IDeviceControlService وصل می‌کنیم) ----
    private Task UpdateStatuses(DeviceViewModel d) => _ops.RunAsync(
           operationKey: $"status:{d.Ip}",
           title: "بروزرسانی وضعیت",
           work: ct => DeviceService.GetForcesStatus(d.Ip, ct),
           ct: _cancellationTokenSource!.Token,
           successMessage: $"وضعیت دستگاه {d.Ip} بروزرسانی شد.",
           failureMessage: "دستگاه وضعیت جدید ارسال نکرد.");

    private void Screenshot2(DeviceViewModel d)      => Snackbar.Add("اسکرین‌شات: " + d.DisplayName, Severity.Success);
    private async Task Screenshot(DeviceViewModel d)
    {
        if (!EnsureOnline(d)) return;
        var bytes = await _ops.RunAsync(
            operationKey: $"screenshot:{d.Ip}",
            title: "اسکرین‌شات",
            work: ct => DeviceService.RequestScreenshotAsync(d.Ip, ct),
            ct: _cancellationTokenSource!.Token,
            emptyMessage: "تصویری از دستگاه دریافت نشد.",
            isEmpty: b => b is null || b.Length == 0);

        if (bytes is null || bytes.Length == 0) return;

        var dataUrl = "data:image/png;base64," + Convert.ToBase64String(bytes);

        DialogService.Show<ScreenShotDialog>("اسکرین‌شات",
            new DialogParameters
            {
                ["ImageDataUrl"] = dataUrl,
                ["Title"] = $"اسکرین‌شات {d.DisplayName}"
            },
            new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                Position = DialogPosition.Center
            });
    }

    private async Task DownloadJournal(DeviceViewModel d)
    {
        if (!EnsureOnline(d)) return;
        var dialog = DialogService.Show<JournalRangeDialog>("دانلود ژورنال",
            new DialogParameters(),
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                Position = DialogPosition.Center
            });

        var result = await dialog.Result;
        if (result.Canceled) return;

        var range = (DateRange)result.Data!;
        var start = range.Start!.Value.Date;
        var end = range.End!.Value.Date.AddDays(1).AddTicks(-1);

        var bytes = await _ops.RunAsync(
            operationKey: $"journal:{d.Ip}",
            title: "دریافت ژورنال",
            work: ct => DeviceService.RequestJournalAsync(d.Ip, start, end, ct),
            ct: _cancellationTokenSource!.Token,
            emptyMessage: "ژورنالی در این بازه یافت نشد.",
            isEmpty: b => b is null || b.Length == 0);

        if (bytes is null || bytes.Length == 0) return;

        var safeIp = (d.Ip ?? "device").Replace('.', '_').Replace(':', '_');
        var name = $"journal_{safeIp}_{start:yyyyMMdd}-{end:yyyyMMdd}";

        if (LooksLikeZip(bytes))
        {
            await SaveFileAsync(bytes, name + ".zip", "application/zip");
        }
        else
        {
            await SaveFileAsync(bytes, name + ".txt", "text/plain");
            Snackbar.Add("فایل دریافتی زیپ نبود؛ به‌صورت متن ذخیره شد.", Severity.Info);
        }

        Snackbar.Add("دانلود ژورنال آماده شد.", Severity.Success);
    }
    private Task Reboot(DeviceViewModel d) => _ops.RunAsync(
        operationKey: $"reboot:{d.Ip}",
        title: "راه‌اندازی مجدد",
        work: ct => DeviceService.RestartOrShutdownDevice(true,d.Ip, ct),
        ct: _cancellationTokenSource!.Token,
        successMessage: $"فرمان راه‌اندازی مجدد برای {d.Ip} ارسال شد.",
        failureMessage: "دستگاه فرمان را نپذیرفت.");

    private Task Shutdown(DeviceViewModel d) => _ops.RunAsync(
         operationKey: $"shutdown:{d.Ip}",
         title: "خاموش کردن",
         work: ct => DeviceService.RestartOrShutdownDevice(false, d.Ip, ct),
         ct: _cancellationTokenSource!.Token,
         successMessage: $"فرمان خاموشی برای {d.Ip} ارسال شد.",
         failureMessage: "دستگاه فرمان را نپذیرفت.");

    public async Task uploadDialog( string Ip)
    {
        var dialog = await DialogService.ShowAsync<FileUploadDialog>();
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UploadResult uploadResult)
        {
            await UploadFile(uploadResult.File, Ip);

        }
    }
    private DeviceVendor? _vendor;

    private async Task OnVendorChanged(DeviceVendor? v)
    {
        _vendor = v;
        if (table is not null) await table.ReloadServerData();
    }
    private async Task UploadFile(IBrowserFile file, string Ip)
    {
        try
        {


            if (file is null)
            {
                return;
            }
            StateHasChanged();

            var extension = Path.GetExtension(file.Name);
            var contentType = file.ContentType;
            if (string.IsNullOrEmpty(contentType))
            {
                contentType = "application/octet-stream";
            }
            _isLoadingScreenshot = true;
            var result = await DeviceService.RequestUploadFileAsync(Ip, file);
            _isLoadingScreenshot = false;
            if (result)
            {
                _logger.Info(
             "FILE UPLOAD SUCCESS. IP={IP}, FileName={FileName}, Size={Size}",
             Ip,
             file.Name,
             file.Size);

                Snackbar.Add("آپلود فایل با موفقیت انجام شد!", Severity.Success);

            }
        }
        catch (OperationCanceledException)
        {

        }
        catch (Exception ex)
        {

            Snackbar.Add("آپلود فایل با خطا مواجه شد لطفا مجدد تلاش فرمایید!", Severity.Error);
        }
    }

    private async Task ExportDeviceExcel()
    {
        var filter = new DeviceFilterViewModel
        {
            Search = _search,
            Status = _status,
            Branch = _branchId,
            Vendor = _vendor,
        };
        var base64=   await DeviceService.ExportExcelAsync(filter);
        if (string.IsNullOrWhiteSpace(base64))
        {
             Snackbar.Add("فایل تولید نشد.",Severity.Error);
            return;
        }

        var mime = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
        var fileName = $"گزارش-دستگاه ها-{DateTime.Now:yyyyMMddHHmmss}.xlsx";


        await JS.InvokeVoidAsync("downloadBase64File", mime, base64, fileName);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        try
        {
            _cancellationTokenSource?.Cancel();
            _cancellationTokenSource?.Dispose();
            _reloadGate.Dispose();
        
        }
        catch { }
        if (_timer is not null)
        {
            _timer.Dispose();
        }
        if (_refreshLoop is not null)
        {
            try { await _refreshLoop.WaitAsync(TimeSpan.FromSeconds(3)); }
            catch { }
        }
        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.StopAsync();
                await _hubConnection.DisposeAsync();
            }
            catch { }
        }
    }
    private bool EnsureOnline(DeviceViewModel d)
    {
        if (d.DeviceAgent is false)
        {
            Snackbar.Add($"دستگاه {d.Ip} آفلاین است — فرمان ارسال نشد.", Severity.Warning);
            return false;
        }
        return true;
    }
    
