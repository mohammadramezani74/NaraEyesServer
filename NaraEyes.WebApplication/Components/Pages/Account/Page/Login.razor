@page "/account/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using NaraEyes.Domain.Entities.Identity
@using NaraEyes.WebApplication.Services
@inject SignInManager<User> SignInManager
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor Http
@inject ICaptchaManager Captcha
@inject ILoginRateLimiter LoginLimiter
@inject ILogger<Login> Logger

<div class="page-bg" dir="rtl">
    <div class="login-card">
        <div class="brand">
            <div ;" class="logo">
                <img src="lib/assets/images/naraeyes-logo.svg"
                     alt="NaraEyes Logo"
                     style="width:135px; height:auto; margin:auto; display:block;padding-left: 40px;" />
            </div>
            <h1>ورود به سامانه</h1>
            <p>لطفاً نام کاربری و رمز عبور را وارد کنید</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <EditForm EditContext="@editContext"
                  OnSubmit="@HandleSubmit"
                  FormName="frmLogin"
                  Method="post">

            <div class="mb-3">
                <label for="username" class="form-label">نام کاربری</label>
                <InputText id="username"
                           name="loginModel.UserName"
                           @bind-Value="loginModel.UserName"
                           class="form-control"
                           placeholder="نام کاربری را وارد کنید" />
                <ValidationMessage For="@(() => loginModel.UserName)" class="text-danger" />
            </div>

            <div class="mb-2">
                <label for="password" class="form-label">رمز عبور</label>
                <InputText id="password"
                           name="loginModel.Password"
                           type="password"
                           @bind-Value="loginModel.Password"
                           class="form-control"
                           placeholder="رمز عبور را وارد کنید" />
                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
            </div>

            <div class="mb-2">
                <label class="form-label">کد امنیتی</label>
                <div class="d-flex align-items-center gap-2">
                    <img src="@captchaImage" alt="captcha"
                         style="height:50px;border:1px solid #ccc;border-radius:6px" />

                    <button type="submit"
                            name="__action"
                            value="refresh"
                            formnovalidate
                            class="btn btn-outline-info">
                        تعویض
                    </button>
                </div>

                <InputText id="captcha"
                           name="loginModel.CaptchaCode"
                           @bind-Value="loginModel.CaptchaCode"
                           class="form-control mt-2"
                           placeholder="کد روی تصویر"
                           autocomplete="off" />
                <ValidationMessage For="@(() => loginModel.CaptchaCode)" class="text-danger" />
            </div>


            <input type="hidden"
                   name="loginModel.CaptchaToken"
                   value="@loginModel.CaptchaToken" />

            <div class="form-check mb-3">
                <InputCheckbox id="remember"
                               name="loginModel.RememberMe"
                               @bind-Value="loginModel.RememberMe"
                               class="form-check-input" />
                <label class="form-check-label" for="remember">مرا به خاطر بسپار</label>
            </div>


            <button type="submit"
                    name="__action"
                    value="login"
                    class="btn btn-primary w-100"
                    disabled="@isBusy">
                @(isBusy ? "در حال ورود..." : "ورود")
            </button>
        </EditForm>

        <div class="footer-note">
            <small>© @DateTime.Now.Year Nara Eyes • امنیت شما برای ما مهم است.</small>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "frmLogin")]
    private LoginModel loginModel { get; set; } = new();

    private EditContext editContext = default!;
    private bool isBusy = false;
    private string? error;
    private string captchaImage = "";

    private bool IsPost =>
        string.Equals(Http.HttpContext?.Request?.Method, "POST", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User?.Identity?.IsAuthenticated == true)
        {
            Http.HttpContext!.Response.Redirect("/dashboard");
            return;
        }

        editContext = new EditContext(loginModel);

        if (!IsPost)
            RefreshCaptcha();
    }

    private async Task HandleSubmit(EditContext _)
    {

        var form = Http.HttpContext?.Request?.Form;
        var action = form?["__action"].ToString();

        if (string.Equals(action, "refresh", StringComparison.OrdinalIgnoreCase))
        {
   
            RefreshCaptcha();
            return;
        }

        if (!string.Equals(action, "login", StringComparison.OrdinalIgnoreCase))
        {
 
            RefreshCaptcha();
            return;
        }

    
        if (!editContext.Validate())
        {
    
            RefreshCaptcha();
            return;
        }

        try
        {
            error = null;
            isBusy = true;

            var ip = Http.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";
            if (!LoginLimiter.IsAllowed(loginModel.UserName, ip))
            {
                error = "تعداد تلاش‌ها زیاد است. چند لحظه دیگر دوباره تلاش کنید.";
                RefreshCaptcha();
                return;
            }

       
            var captchaOk = Captcha.ValidateAndConsume(loginModel.CaptchaToken, loginModel.CaptchaCode);
            if (!captchaOk)
            {
                error = "کد امنیتی نادرست یا منقضی است.";
                RefreshCaptcha();
                return;
            }

            var result = await SignInManager.PasswordSignInAsync(
                loginModel.UserName?.Trim() ?? "",
                loginModel.Password ?? "",
                loginModel.RememberMe,
                lockoutOnFailure: true);

            if (result.Succeeded)
            {
                Http.HttpContext!.Response.Redirect("/dashboard");
                return;
            }
            else if (result.IsLockedOut)
            {
                error = "حساب شما موقتاً قفل شد. لطفاً بعداً تلاش کنید.";
                Logger.LogWarning("User {User} locked out from IP {IP}", loginModel.UserName, ip);
            }
            else if (result.RequiresTwoFactor)
            {
                error = "احراز هویت دومرحله‌ای فعال است.";
            }
            else
            {
                error = "نام کاربری یا رمز عبور نادرست است.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            error = "خطای غیرمنتظره رخ داد. لطفاً مجدداً تلاش کنید.";
        }
        finally
        {
            isBusy = false;
            // چه موفق چه ناموفق – کپچا جدید
            RefreshCaptcha();
        }
    }

    private void RefreshCaptcha()
    {
        var (token, img) = Captcha.Generate();
        loginModel.CaptchaToken = token; // با فرم پست می‌شود
        captchaImage = img;              // data URL
        loginModel.CaptchaCode = "";     // کاربر دوباره تایپ کند
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "نام کاربری الزامی است.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "رمز عبور الزامی است.")]
        [MinLength(6, ErrorMessage = "رمز عبور باید حداقل ۶ کاراکتر باشد.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "کد امنیتی الزامی است.")]
        [MinLength(6, ErrorMessage = "کد امنیتی حداقل ۶ کاراکتر است.")]
        public string CaptchaCode { get; set; } = "";

        public string CaptchaToken { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}
