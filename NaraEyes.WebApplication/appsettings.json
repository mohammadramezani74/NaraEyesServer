{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"ApplicationDbContext": "Server=172.30.60.50;Database=NaraEyesDb;User Id=nara;Password=Nara@@12;TrustServerCertificate=True;Integrated Security = False;Encrypt=false"
    "ApplicationDbContext": "Server=.;Database=NaraEyes;User Id=sa;Password=39143914;TrustServerCertificate=True;Integrated Security = False;Encrypt=false"

  },
  "Retention": {
    "Enabled": true,
    "DryRun": true,

    "InBoxProcessedDays": 30,
    "OutBoxProcessedDays": 30,
    "DeviceEventAckDays": 90,
    "ModuleFaultResolvedDays": 365,

    "BatchSize": 2000,
    "DelayBetweenBatchesMs": 500,
    "MaxRowsPerRun": 200000,

    "WindowStartHour": 2,
    "WindowEndHour": 5,
    "CheckIntervalMinutes": 30
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "NaraEyesApp"
    }
  },
  "AdminPassword": "Nara@@12",
  "AgentSecurity": {
    "SharedKey": "K7mQ2xV9pL4zR8nT6wY3cH5sD1fG0bA"
  }
}
